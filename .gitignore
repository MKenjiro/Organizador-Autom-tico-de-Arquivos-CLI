import shutil
import argparse
from pathlib import Path

CATEGORIES = {
    "Imagens": {".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp"},
    "Documentos": {".pdf", ".docx", ".txt", ".xlsx", ".pptx", ".csv"},
    "Compactados": {".zip", ".rar", ".tar", ".gz", ".7z"},
    "Codigo": {".py", ".js", ".html", ".css", ".json", ".ts", ".sql"},
    "Executaveis": {".exe", ".msi", ".deb", ".dmg", ".sh"},
    "Midia": {".mp4", ".mp3", ".wav", ".mkv", ".mov"}
}

def organize_folder(target_dir: Path, dry_run: bool = False):
    if not target_dir.exists() or not target_dir.is_dir():
        print(f"Erro: O diretório '{target_dir}' não é válido.")
        return

    moved_count = 0
    for item in target_dir.iterdir():
        if item.is_dir() or item.name.startswith("."):
            continue

        ext = item.suffix.lower()
        category = "Outros"
        for cat_name, extensions in CATEGORIES.items():
            if ext in extensions:
                category = cat_name
                break

        dest_folder = target_dir / category
        dest_path = dest_folder / item.name

        if dry_run:
            print(f"[Simulação] Moveria: {item.name} -> {category}/")
        else:
            dest_folder.mkdir(exist_ok=True)
            # Evita sobrescrever arquivos com o mesmo nome
            counter = 1
            while dest_path.exists():
                dest_path = dest_folder / f"{item.stem}_{counter}{item.suffix}"
                counter += 1
            shutil.move(str(item), str(dest_path))
            print(f"Movido: {item.name} -> {dest_path.relative_to(target_dir)}")
        moved_count += 1

    print(f"\nConcluído! Total de arquivos processados: {moved_count}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Organiza arquivos de um diretório por categoria.")
    parser.add_argument("path", type=str, help="Caminho do diretório a ser organizado")
    parser.add_argument("--dry-run", action="store_true", help="Simula a organização sem mover os arquivos")
    args = parser.parse_args()

    organize_folder(Path(args.path), args.dry_run)
